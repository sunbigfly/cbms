# ================================
# CBMS 环境配置模板
# ================================
# 复制此文件为 .env 并填写实际值

# ----- 数据库配置 (必需) -----
# PostgreSQL 连接字符串
# 格式: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://user:password@localhost:5432/cbms?schema=public"

# ----- Redis 缓存配置 (可选) -----
# 如不配置，系统将在无缓存模式下运行，不影响核心功能
# 格式: redis://HOST:PORT 或 redis://USER:PASSWORD@HOST:PORT
REDIS_URL="redis://localhost:6379"

# ----- NextAuth 认证配置 (必需) -----
# 应用 URL (开发环境通常为 http://localhost:3000)
NEXTAUTH_URL="http://localhost:3000"

# 安全密钥 (生产环境请使用强随机字符串，最少32字符)
# 可使用命令生成: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"

# ----- OAuth 提供商 (可选) -----
# 如需启用第三方登录，请配置以下选项
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GITHUB_ID=""
# GITHUB_SECRET=""

# ----- 初始化配置 (Seed) -----
# 用于 prisma db seed 初始化默认管理员
ADMIN_EMPLOYEE_ID="admin"
ADMIN_PASSWORD="changeme123" # 生产环境务必修改
ADMIN_EMAIL="admin@cbms.local"
